# Server port and the URL browsers use to reach the app. Redirects and mock QR links are built from it.
PORT=8787
PUBLIC_URL=http://localhost:8787

# --- World ID via the official SDK (@worldcoin/idkit-core), sandbox environment ---
# Create an app in https://developer.world.org (World ID Sandbox), register the action "rescue-robot",
# then copy the three values below. The sandbox World App (TestFlight / Play testing) scans the QR.
#WORLD_APP_ID=app_...
#WORLD_RP_ID=rp_...
#WORLD_SIGNING_KEY=<hex RP signing key>
#WORLD_ENVIRONMENT=sandbox
# Proof mode. 'session' (default) uses World ID session proofs: repeatable per person, no portal action needed.
# 'uniqueness' uses one action-scoped proof per person (World treats it as one-time), needs WORLD_ACTION registered.
#WORLD_PROOF_MODE=session
#WORLD_ACTION=rescue-robot
# The portal's integrity check only knows production/staging attestation issuers, so sandbox World App proofs fail with
# integrity_verification_failed. The bundle is optional for proof-of-human; set this to drop it before forwarding.
#WORLD_STRIP_INTEGRITY_BUNDLE=1
# Sandbox proofs verify only while a staging window is open for the app. Open one with the Developer Portal MCP
# tool set_world_id_staging_verification (needs a portal API key, WORLD_PORTAL_API_KEY); it lasts 24 h and returns
# this token, which is sent as x-staging-verification-token on verify calls.
#WORLD_PORTAL_API_KEY=api_...
#WORLD_STAGING_VERIFICATION_TOKEN=

# --- Alternative: Sign in with World ID (OIDC) instead of IDKit ---
# Sandbox rejects http://localhost callbacks: expose the server over HTTPS (ngrok / cloudflared), set PUBLIC_URL
# to that URL and register <PUBLIC_URL>/auth/callback as the redirect URI.
#WORLD_ISSUER=https://sandbox.auth.world.org
#WORLD_CLIENT_ID=
#WORLD_CLIENT_SECRET=

# With none of the above set, a local mock World App is used (same modal, same proof shape, HMAC-signed proofs).

# --- Real WLD payouts on World Chain (leave unset for simulated payouts) ---
# Treasury EOA that pays workers. Needs WLD for rewards and a little ETH on World Chain for gas. Never commit this.
#TREASURY_PRIVATE_KEY=
# mainnet (chain 480, default) or sepolia (chain 4801) for rehearsals
#WORLD_CHAIN=mainnet
# RPC: World's official public endpoints are https://worldchain-mainnet.g.alchemy.com/public and
# https://worldchain-sepolia.g.alchemy.com/public. With an Alchemy key use https://worldchain-mainnet.g.alchemy.com/v2/<KEY>.
#WORLD_CHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
# Canonical WLD: mainnet 0x2cFc85d8E48F8EAB294be644d9E25C3030863003, sepolia 0x8803e47fD253915F9c860837f391Aa71B3e03c5A
#WLD_TOKEN=0x2cFc85d8E48F8EAB294be644d9E25C3030863003

# --- Persistence (Supabase Postgres). Leave unset to run in memory. ---
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" URI.
#DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- The robot's agent (writes jobs when stuck, reviews and scores the human's work) ---
# Without a key a rule-based fallback is used. Model defaults to claude-opus-5.
#ANTHROPIC_API_KEY=sk-ant-...
#AGENT_MODEL=claude-opus-5
# AGENT_MODE=external connects an outside agent (a Claude Code / Codex session, any process) instead of calling the API:
# it polls GET /api/agent/tasks with `Authorization: Bearer $AGENT_TOKEN`, and posts JobSpec / Verdict JSON to
# POST /api/agent/tasks/:id. Unanswered tasks fall back to the rules after AGENT_EXTERNAL_TIMEOUT_MS (default 180000).
#AGENT_MODE=external
#AGENT_TOKEN=<random secret>
#AGENT_EXTERNAL_TIMEOUT_MS=180000
